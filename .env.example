# --- Core ---------------------------------------------------------------------------------------
# config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# [required in production] 50+ random characters.
SECRET_KEY=
# Local settings only; production is always False.
DEBUG=True
# Label for logs and error tracking: local | develop | staging | production
ENVIRONMENT=local

# --- Database -----------------------------------------------------------------------------------
# [required in production]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uk_backend
# Seconds to keep connections open between requests (0 = close after each request).
DB_CONN_MAX_AGE=60

# --- Redis --------------------------------------------------------------------------------------
# [required in production] Holds API rate-limit counters and login lockouts.
REDIS_URL=redis://localhost:6379/0

# --- Email --------------------------------------------------------------------------------------

DEFAULT_FROM_EMAIL=1Theory <info@1theory.co.uk>

POSTMARK_SERVER_TOKEN=
EMAIL_BACKEND=
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587

# --- Background jobs ----------------------------------------------------------------------------
# [required in production] Celery's queue. A different Redis database from the cache above.
CELERY_BROKER_URL=redis://localhost:6379/1
# Deployment only, and only where a separate worker service is not available (Render's free plan):
# runs the Celery worker and beat inside the web container. Leave false everywhere else; locally
# compose.yaml runs them as their own services.
RUN_WORKER_IN_WEB=false
# Processes in the web container. Both are deliberately 1 on a 512 MB free instance.
WEB_CONCURRENCY=1

# --- Learning -----------------------------------------------------------------------------------
# Where the cabinet sends a customer with active access.
LEARNING_URL=https://1theory.co.uk/

# --- Payments -------------------------------------------------------------------------------------
# [required in production] From the Stripe dashboard.
STRIPE_SECRET_KEY=
# [required in production] The signing secret of the webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in ------------------------------------------------------------------------------
# Comma-separated OAuth client ids (web, mobile). Google sign-in is refused while this is empty.
GOOGLE_CLIENT_IDS=

# --- Hosts & origins (comma-separated) ----------------------------------------------------------
# [required in production]
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# --- URLs ---------------------------------------------------------------------------------------
# [required in production] Storefront/cabinet frontend; a trailing slash is added if missing.
FRONTEND_BASE_URL=http://localhost:3000/
BACKEND_BASE_URL=http://localhost:8000/
# Path the Django admin is served on.
ADMIN_URL=api/admin/

# Number of trusted proxies that add to X-Forwarded-For.
# Must match the deployment to prevent IP spoofing.
# 0 = no proxy (local development)
# 1 = load balancer (default in production)
# 2 = CDN + load balancer
TRUSTED_PROXY_COUNT=0

# --- HTTPS (production settings only) -----------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Uploaded files (video, documents, images) ---------------------------------------------------
# An S3-compatible bucket. Leave S3_BUCKET_NAME empty to store uploads on the local filesystem
# instead, which is fine for development but is lost on every deploy.
# For Cloudflare R2: the endpoint is https://<account id>.r2.cloudflarestorage.com and the
# region is "auto", because R2 has no regions.
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# How long a signed file URL stays valid. Long enough to watch a video, short enough that a
# shared link stops working.
S3_URL_EXPIRY_SECONDS=3600

# --- Browser Web Push ---------------------------------------------------------------------------
# Generate once per environment with: python manage.py generate_vapid_keys --output-dir /secure/path
# Public: URL-safe base64 applicationServerKey. Private: base64 DER, stored only in secret settings.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:info@1theory.co.uk

# --- Core ---------------------------------------------------------------------------------------
# config.settings.local | config.settings.test | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.local
# [required in production] 50+ random characters.
SECRET_KEY=
# Local settings only; production is always False.
DEBUG=True
# Label for logs and error tracking: local | develop | staging | production
ENVIRONMENT=local

# --- Database -----------------------------------------------------------------------------------
# [required in production]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/uk_backend
# Seconds to keep connections open between requests (0 = close after each request).
DB_CONN_MAX_AGE=60

# --- Redis --------------------------------------------------------------------------------------
# [required in production] Holds API rate-limit counters and login lockouts.
REDIS_URL=redis://localhost:6379/0

# --- Email --------------------------------------------------------------------------------------

DEFAULT_FROM_EMAIL=1Theory <info@1theory.co.uk>

POSTMARK_SERVER_TOKEN=
EMAIL_BACKEND=
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587

# --- Background jobs ----------------------------------------------------------------------------
# [required in production] Celery's queue. A different Redis database from the cache above.
CELERY_BROKER_URL=redis://localhost:6379/1
# Deployment only, and only where a separate worker service is not available (Render's free plan):
# runs the Celery worker and beat inside the web container. Leave false everywhere else; locally
# compose.yaml runs them as their own services.
RUN_WORKER_IN_WEB=false
# Processes in the web container. Both are deliberately 1 on a 512 MB free instance.
WEB_CONCURRENCY=1
# Transcoding is routed to its own queue so that an encode, which takes minutes, cannot delay a
# password-reset email. Which containers consume which queue is a deployment decision.
VIDEO_TASK_QUEUE=video
CELERY_TASK_DEFAULT_QUEUE=celery
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# --- Learning -----------------------------------------------------------------------------------
# Where the cabinet sends a customer with active access.
LEARNING_URL=https://1theory.co.uk/

# --- Payments -------------------------------------------------------------------------------------
# [required in production] From the Stripe dashboard.
STRIPE_SECRET_KEY=
# [required in production] The signing secret of the webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in ------------------------------------------------------------------------------
# Comma-separated OAuth client ids (web, mobile). Google sign-in is refused while this is empty.
GOOGLE_CLIENT_IDS=

# --- Hosts & origins (comma-separated) ----------------------------------------------------------
# [required in production]
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# --- URLs ---------------------------------------------------------------------------------------
# [required in production] Storefront/cabinet frontend; a trailing slash is added if missing.
FRONTEND_BASE_URL=http://localhost:3000/
BACKEND_BASE_URL=http://localhost:8000/
# Path the Django admin is served on.
ADMIN_URL=api/admin/

# Number of trusted proxies that add to X-Forwarded-For.
# Must match the deployment to prevent IP spoofing.
# 0 = no proxy (local development)
# 1 = load balancer (default in production)
# 2 = CDN + load balancer
TRUSTED_PROXY_COUNT=0

# --- HTTPS (production settings only) -----------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Uploaded files (video, documents, images) ---------------------------------------------------
# An S3-compatible bucket. Leave S3_BUCKET_NAME empty to store uploads on the local filesystem
# instead, which is fine for development but is lost on every deploy.
# For Cloudflare R2: the endpoint is https://<account id>.r2.cloudflarestorage.com and the
# region is "auto", because R2 has no regions.
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# How long a signed file URL stays valid. Long enough to watch a video, short enough that a
# shared link stops working.
S3_URL_EXPIRY_SECONDS=3600

VIDEO_UPLOAD_PREFIX=learning/video-source
VIDEO_HLS_PREFIX=learning/video-hls

VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_MAX_DURATION_SECONDS=10800

VIDEO_UPLOAD_URL_EXPIRY_SECONDS=900
VIDEO_UPLOAD_SESSION_TTL_SECONDS=86400

# Uploads at or above the threshold are cut into parts of this size. S3 refuses a part under
# 5 MiB, so do not set the part size lower than 5242880.
VIDEO_MULTIPART_THRESHOLD_BYTES=104857600
VIDEO_MULTIPART_PART_BYTES=16777216

VIDEO_TRANSCODING_ENABLED=True
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FFMPEG_PRESET=veryfast

VIDEO_FFMPEG_THREADS=0
VIDEO_HLS_SEGMENT_SECONDS=6
VIDEO_PROBE_TIMEOUT_SECONDS=120
VIDEO_TRANSCODE_TIMEOUT_SECONDS=10800
VIDEO_PROCESSING_MAX_ATTEMPTS=3

VIDEO_WORKSPACE_DIR=
VIDEO_WORKSPACE_HEADROOM_FACTOR=3.5

VIDEO_HEARTBEAT_SECONDS=60
VIDEO_HEARTBEAT_GRACE_SECONDS=300

CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_COOKIE_DOMAIN=
CLOUDFRONT_SIGNED_TTL_SECONDS=14400

VIDEO_ALLOW_UNSIGNED_PLAYBACK=False
